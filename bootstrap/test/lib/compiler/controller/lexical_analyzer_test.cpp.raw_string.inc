  ASSERT_EQ(token->getToken(), U"\\`");
  token = tis.read();
  ASSERT_EQ(token->getTokenType(), TokenTypeEnum::ltRawStringLineBreak);
  ASSERT_EQ(token->getToken(), U"\r\n");
  token = tis.read();
  ASSERT_EQ(token->getTokenType(), TokenTypeEnum::scBackQuotation);
  ASSERT_EQ(token->getToken(), U"`");

  str = U"`\\a`\n";

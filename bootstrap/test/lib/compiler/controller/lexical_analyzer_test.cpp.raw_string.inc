  str = U"`\\0`\n";
  buf = std::vector<int32_t>(str.begin(), str.end());
  lines.resetBuffer();
  lines.appendBuffer(buf);
  lexer = LexicalAnalyzer(lines, CompilerModeEnum::compilerFromStdin);
  tis = lexer.getTokensInputStream();
  token = tis.read();
  ASSERT_EQ(token->getTokenType(), TokenTypeEnum::scBackQuotation);
  ASSERT_EQ(token->getToken(), U"`");
  token = tis.read();
  ASSERT_EQ(token->getTokenType(), TokenTypeEnum::ltRawString);
  ASSERT_EQ(token->getToken(), U"\\0");
  token = tis.read();
  ASSERT_EQ(token->getTokenType(), TokenTypeEnum::scBackQuotation);
  ASSERT_EQ(token->getToken(), U"`");
  {
    int32_t *escapeCharCode = token->preParseEscapeUtf32CharCode();
    ASSERT_EQ(escapeCharCode, nullptr);
  }

  str = U"`\\`aaaa`";
  buf = std::vector<int32_t>(str.begin(), str.end());
  lines.resetBuffer();
  lines.appendBuffer(buf);
  lexer = LexicalAnalyzer(lines, CompilerModeEnum::compilerFromStdin);
  tis = lexer.getTokensInputStream();
  token = tis.read();
  ASSERT_EQ(token->getTokenType(), TokenTypeEnum::scBackQuotation);
  ASSERT_EQ(token->getToken(), U"`");
  token = tis.read();
  ASSERT_EQ(token->getTokenType(),
            TokenTypeEnum::ltEscapeSequenceBackQuotation);
  ASSERT_EQ(token->getToken(), U"\\`");
  {
    int32_t *escapeCharCode = token->preParseEscapeUtf32CharCode();
    ASSERT_EQ(*escapeCharCode,
              static_cast<int32_t>(CharCode::UtfAsciiTable::BackQuotation));
  }
  token = tis.read();
  ASSERT_EQ(token->getTokenType(), TokenTypeEnum::ltRawString);
  ASSERT_EQ(token->getToken(), U"aaaa");
  token = tis.read();
  ASSERT_EQ(token->getTokenType(), TokenTypeEnum::scBackQuotation);
  ASSERT_EQ(token->getToken(), U"`");

  str = U"`\\\r`";
  buf = std::vector<int32_t>(str.begin(), str.end());
  lines.resetBuffer();
  lines.appendBuffer(buf);
  lexer = LexicalAnalyzer(lines, CompilerModeEnum::compilerFromStdin);
  tis = lexer.getTokensInputStream();
  token = tis.read();
  ASSERT_EQ(token->getTokenType(), TokenTypeEnum::scBackQuotation);
  ASSERT_EQ(token->getToken(), U"`");

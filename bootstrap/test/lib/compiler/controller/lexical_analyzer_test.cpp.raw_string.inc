  lines.resetBuffer();
  lines.appendBuffer(buf);
  lexer = LexicalAnalyzer(lines, CompilerModeEnum::compilerFromStdin);
  tis = lexer.getTokensInputStream();
  token = tis.read();
  ASSERT_EQ(token->getTokenType(), TokenTypeEnum::scBackQuotation);
  ASSERT_EQ(token->getToken(), U"`");
  token = tis.read();
  ASSERT_EQ(token->getTokenType(), TokenTypeEnum::ltRawString);
  ASSERT_EQ(token->getToken(), U"\\a");
  token = tis.read();
  ASSERT_EQ(token->getTokenType(), TokenTypeEnum::scBackQuotation);
  ASSERT_EQ(token->getToken(), U"`");

  str = U"`\\b`\n";
  buf = std::vector<int32_t>(str.begin(), str.end());
  lines.resetBuffer();
  lines.appendBuffer(buf);
  lexer = LexicalAnalyzer(lines, CompilerModeEnum::compilerFromStdin);
  tis = lexer.getTokensInputStream();
  token = tis.read();
  ASSERT_EQ(token->getTokenType(), TokenTypeEnum::scBackQuotation);
  ASSERT_EQ(token->getToken(), U"`");
  token = tis.read();
  ASSERT_EQ(token->getTokenType(), TokenTypeEnum::ltRawString);
  ASSERT_EQ(token->getToken(), U"\\b");
  token = tis.read();
  ASSERT_EQ(token->getTokenType(), TokenTypeEnum::scBackQuotation);
  ASSERT_EQ(token->getToken(), U"`");

  str = U"`\\t`\n";
  buf = std::vector<int32_t>(str.begin(), str.end());
  lines.resetBuffer();
  lines.appendBuffer(buf);
  lexer = LexicalAnalyzer(lines, CompilerModeEnum::compilerFromStdin);
  tis = lexer.getTokensInputStream();
  token = tis.read();
  ASSERT_EQ(token->getTokenType(), TokenTypeEnum::scBackQuotation);
  ASSERT_EQ(token->getToken(), U"`");
  token = tis.read();
  ASSERT_EQ(token->getTokenType(), TokenTypeEnum::ltRawString);
  ASSERT_EQ(token->getToken(), U"\\t");
  token = tis.read();
  ASSERT_EQ(token->getTokenType(), TokenTypeEnum::scBackQuotation);
  ASSERT_EQ(token->getToken(), U"`");

  str = U"`\\n`\n";
  buf = std::vector<int32_t>(str.begin(), str.end());
  lines.resetBuffer();
  lines.appendBuffer(buf);
  lexer = LexicalAnalyzer(lines, CompilerModeEnum::compilerFromStdin);
  tis = lexer.getTokensInputStream();
  token = tis.read();
  ASSERT_EQ(token->getTokenType(), TokenTypeEnum::scBackQuotation);
  ASSERT_EQ(token->getToken(), U"`");
